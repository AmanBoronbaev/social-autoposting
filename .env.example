# Only this secret URL path is proxied by Nginx. It is not a replacement for
# authentication; generate a new value with: openssl rand -hex 24
APP_PATH=/panel-CHANGE_ME_WITH_A_LONG_RANDOM_VALUE/
APP_DOMAIN=biamino.cc
CERTBOT_EMAIL=owner@example.com
# Docker Compose creates this internal database URL itself; do not add a
# public database address here.
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD

# Generate both values locally; never commit them or send them in a chat.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# The first owner account is created only on the initial database setup.
# After the first deployment, remove the password line from .env; further
# customer accounts are created by the owner in the Admin page/API.
APP_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_A_LONG_UNIQUE_PASSWORD

# This is a public API base URL, not a credential. Every customer's Zernio API
# token is stored encrypted through the Superuser page, never in this file.
ZERNIO_API_BASE_URL=https://zernio.com/api/v1

# This is a public API base URL, not a credential. Every customer's Telegram
# Bot token is stored encrypted through the Superuser page.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_MAX_UPLOAD_BYTES=52428800
# Optional local Telegram Bot API server. It keeps using every customer's bot
# token, but permits up to 2 GB at the Bot API layer. To enable it, set all
# four values below in the *server's* .env, then redeploy. Keep the service
# internal: do not publish port 8081 or give these app credentials to clients.
# COMPOSE_PROFILES=telegram-local-api
# TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_MAX_UPLOAD_BYTES=524288000
WHAPI_MAX_MEDIA_BYTES=104857600
# Maximum time to prepare one uploaded video with FFmpeg.
APP_MEDIA_PREPARE_TIMEOUT_SECONDS=900

# Source uploads up to 500 MiB. Videos are normalised to MP4/H.264/AAC and
# downscaled to a maximum 1080p before publication. Provider limits still
# apply, notably Telegram's standard 50 MB Bot API limit.
APP_MAX_UPLOAD_BYTES=524288000
APP_WORKER_POLL_SECONDS=3
# Two workers process distinct deliveries in parallel. Keep this between 1 and 4
# to avoid hitting social-platform rate limits on a small server.
APP_WORKER_REPLICAS=2
