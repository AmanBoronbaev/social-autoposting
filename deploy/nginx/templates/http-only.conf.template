server_tokens off;
log_format autoposting_safe '$remote_addr - $status $request_method $body_bytes_sent';
access_log /var/log/nginx/access.log autoposting_safe;
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_status 429;

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN};
    client_max_body_size ${APP_MAX_UPLOAD_BYTES};
    client_body_timeout 7200s;
    send_timeout 7200s;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = ${APP_PATH}v1/auth/login {
        limit_req zone=login burst=10 nodelay;
        proxy_pass http://web:8000/v1/auth/login;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${APP_PATH} {
        proxy_pass http://web:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_send_timeout 7200s;
        proxy_read_timeout 7200s;
    }

    location / { return 404; }
}
